// Prisma Schema - Project Board PWA
// Learn more at: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Project Board Models
model Member {
  id        String     @id @default(dbgenerated("nextval('members_id_seq')::text"))
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  assignedProjects  Project[]
  assignedTasks     Task[]    @relation("TaskAssignee")

  @@map("members")
}

model Project {
  id          String   @id @default(dbgenerated("nextval('projects_id_seq')::text"))
  title       String
  description String?
  status      String   @default("not_started") // not_started, in_progress, completed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignees   Member[]

  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  customFieldValues Json?

  tasks         Task[]
  incomeRecords IncomeRecord[]
  transfers     Transfer[]

  @@map("projects")
}

model Account {
  id          String   @id @default(dbgenerated("nextval('accounts_id_seq')::text"))
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  records      IncomeRecord[]
  transfersOut Transfer[]     @relation("TransferFromAccount")
  transfersIn  Transfer[]     @relation("TransferToAccount")

  @@map("accounts")
}

model IncomeRecord {
  id     String   @id @default(dbgenerated("nextval('income_records_id_seq')::text"))
  amount Int
  date   DateTime @default(now())
  note   String?

  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("income_records")
}

// Internal movement of money between two virtual accounts (e.g. splitting a
// completed project's fee from 專案總收入 into the owner's and referrer's
// accounts). Unlike IncomeRecord (money entering one account from outside),
// a Transfer always debits fromAccount and credits toAccount by the same amount.
model Transfer {
  id     String   @id @default(dbgenerated("nextval('transfers_id_seq')::text"))
  amount Int
  date   DateTime @default(now())
  name   String? // purpose, e.g. 業務佣金 / 專案製作費 / 專案諮詢費
  note   String?

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  fromAccountId String
  fromAccount   Account @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: Cascade)

  toAccountId String
  toAccount   Account @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("transfers")
}

model Category {
  id        String          @id @default(dbgenerated("nextval('categories_id_seq')::text"))
  name      String          @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  fields    CategoryField[]
  projects  Project[]

  @@map("categories")
}

model CategoryField {
  id         String   @id @default(dbgenerated("nextval('category_fields_id_seq')::text"))
  name       String
  type       String   // text, number, date, select
  options    String[] @default([])
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, name])
  @@map("category_fields")
}

model DashboardWidget {
  id         String   @id @default(dbgenerated("nextval('dashboard_widgets_id_seq')::text"))
  widgetType String   @unique
  position   Int
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("dashboard_widgets")
}

model Task {
  id        String     @id @default(dbgenerated("nextval('tasks_id_seq')::text"))
  title     String
  description String?
  status    String     @default("todo") // todo, in_progress, done
  priority  String     @default("medium") // low, medium, high
  dueDate   DateTime?
  
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   Member?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("tasks")
}
